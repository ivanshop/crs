select M.ScheduleAt, M.Id,
 (select Name from Countries where Id = M.HomeTeam) as HomeTeam,
 M.HomeTeamGoals, M.AwayTeamGoals, 
 (select Name from Countries where Id = M.AwayTeam) as AawayTeam,
 P.Home, P.Away, P.CreatedAt
from Predictions P, Matches M
where P.MatchId = M.Id
    and P.SeerId = 3
    and P.Home == M.HomeTeamGoals
    and P.Away == M.AwayTeamGoals;
    
select M.Id, M.HomeTeam, M.HomeTeamGoals, M.AwayTeamGoals, M.AwayTeam, P.Home, P.Away
from Predictions P, Matches M
where P.MatchId = M.Id
    and P.SeerId = 2;
    
