CREATE TABLE ExtraTimes (
    Id        INTEGER PRIMARY KEY ASC AUTOINCREMENT,
    MathId    INTEGER REFERENCES Matches (Id),
    SeerId    INTEGER REFERENCES Seers (Id),
    Home      INTEGER,
    Away      NUMERIC,
    CreatedAt TEXT
);

